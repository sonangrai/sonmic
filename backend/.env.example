# Copy to backend/.env and adjust. Read when the backend starts.

# Websites allowed to call the API from a browser, comma-separated, no trailing slash.
# Add your Vercel address, e.g. https://sonmic.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Longest video accepted, and largest audio file.
MAX_DURATION_SECONDS=1800
MAX_FILESIZE_MB=150

# Optional proxy for YouTube requests (needed on cloud hosts like Render, whose IPs YouTube blocks).
# Use a residential proxy; datacenter proxies get blocked too. Leave empty to connect directly.
# e.g. http://user:pass@proxy.example.com:8080 or socks5://user:pass@proxy.example.com:1080
YTDLP_PROXY=
