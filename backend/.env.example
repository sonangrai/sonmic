# Copy to backend/.env and adjust. Read when the backend starts.

# Websites allowed to call the API from a browser, comma-separated, no trailing slash.
# Add your Vercel address, e.g. https://sonmic.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Longest video accepted, and largest audio file.
MAX_DURATION_SECONDS=1800
MAX_FILESIZE_MB=150
