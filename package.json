{
  "name": "sonmic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "cd backend && .venv/bin/uvicorn main:app --reload --port 8000",
    "build": "next build",
    "start": "concurrently -k -n web,api -c cyan,magenta \"pnpm:start:web\" \"pnpm:start:api\"",
    "start:web": "next start",
    "start:api": "cd backend && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000",
    "backend": "bash scripts/backend.sh",
    "user": "cd backend && .venv/bin/python manage.py",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonahang-ui": "^1.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.29.3"
}
